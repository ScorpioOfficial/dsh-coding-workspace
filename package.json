{
    "name":  "@local/python-workspace",
    "version":  "1.0.0",
    "private":  true,
    "description":  "A right-sidebar Python workspace: open a folder, browse files, edit and run Python.",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-sidebar-right",
                                              "@deepseek-ai/dsh-client-ui-workspace"
                                          ]
                           }
            },
    "devDependencies":  {
                            "@esbuild/win32-x64":  "0.25.0",
                            "@xterm/addon-fit":  "0.11.0",
                            "@xterm/xterm":  "6.0.0",
                            "esbuild":  "0.25.0"
                        }
}
