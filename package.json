{
  "name": "@local/python-workspace",
  "version": "1.2.1",
  "description": "A right-sidebar Coding workspace for DeepSeek Harness: browse and edit a folder, pick a Python interpreter, and run code in an embedded real terminal.",
  "license": "MIT",
  "author": "ScorpioOfficial",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "coding-workspace",
    "python",
    "ide",
    "terminal",
    "xterm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScorpioOfficial/dsh-coding-workspace.git"
  },
  "homepage": "https://github.com/ScorpioOfficial/dsh-coding-workspace#readme",
  "bugs": {
    "url": "https://github.com/ScorpioOfficial/dsh-coding-workspace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node tools/build-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src",
    "tools"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.25.0"
  }
}
